# ==============================================================================
# Homelab Git Ignore Rules
# Protects sensitive credentials, environment secrets, and persistent state
# ==============================================================================

# Environment Secrets
.env
*.env
!.env.example
apps/*/.env

# Local Persistent Volumes & Data
volumes/*
!volumes/.gitkeep
data/
db/
*.db
*.sqlite
*.sqlite-journal

# Storage & Mount References
/MyHDDStorage/
*.bak

# SSL Certificates & Secrets
*.crt
*.key
*.pem
letsencrypt/
certs/

# Logs & Temporary Files
*.log
logs/
tmp/
.cache/

# Backup Archives & Temporary Dumps
backups/*
!backups/.gitkeep
!backups/README.md
backup_*
/backup_*
backup_20260729_173118
/backup_20260729_173118
*.sql
*.tar.gz

# Local Private Documentation & Notes (Not committed to Git)
docs_local/
docs_private/
notes/

# OS / Editor Specific Files
.DS_Store
Thumbs.db
.vscode/
.idea/
