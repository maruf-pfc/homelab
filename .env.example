# ==============================================================================
# Global Homelab Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit '.env' containing real secrets to Git.
# Generate strong secrets with: openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 20
# ==============================================================================

# General System Settings
TZ=Asia/Dhaka
PUID=1000
PGID=1000

# Base Storage Paths
# SSD: Fast storage for container configs, application state, and databases
SSD_DATA_DIR=/home/maruf/homelab/volumes

# HDD: Bulk storage for media library, raw backups, and large datasets
HDD_DATA_DIR=/home/maruf/MyHDDStorage

# ==============================================================================
# 📂 CATEGORY 4: NETWORK & INGRESS
# ==============================================================================
ENABLE_CLOUDFLARED=true
# Get your tunnel token from: https://one.dash.cloudflare.com → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

ENABLE_ADGUARD=false
ADGUARD_HTTP_PORT=3002

# ==============================================================================
# 📂 CATEGORY 10: SYSADMIN, DEVOPS & CONTAINER UTILITIES
# ==============================================================================
ENABLE_PORTAINER=true
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443
PORTAINER_TUNNEL_PORT=8000

ENABLE_UPTIME_KUMA=false
UPTIME_KUMA_PORT=3001

ENABLE_IT_TOOLS=true
IT_TOOLS_PORT=8091

# ==============================================================================
# 📂 CATEGORY 3: DASHBOARDS
# ==============================================================================
ENABLE_DASHY=true
DASHBOARD_PORT=7575

ENABLE_HOMEPAGE=false
HOMEPAGE_PORT=3000

ENABLE_GLANCE=false
GLANCE_PORT=8081

# ==============================================================================
# 📂 CATEGORY 2: FINANCE
# ==============================================================================
ENABLE_MAYBE=true
MAYBE_PORT=8092
MAYBE_DB_USER=maybe
MAYBE_DB_PASSWORD=change_this_maybe_password
MAYBE_DB_NAME=maybe_production
MAYBE_SECRET_KEY_BASE=change_this_rails_secret_key_base_in_env

# ==============================================================================
# 📂 CATEGORY 8: PRODUCTIVITY
# ==============================================================================
ENABLE_LEANTIME=true
LEANTIME_PORT=8090
LEANTIME_DB_ROOT_PASSWORD=change_this_root_password_in_env
LEANTIME_DB_USER=leantime
LEANTIME_DB_PASSWORD=change_this_user_password_in_env
LEANTIME_DB_NAME=leantime

ENABLE_CHANGEDETECTION=true
CHANGEDETECTION_PORT=5001

ENABLE_STIRLING_PDF=true
STIRLING_PDF_PORT=8084

ENABLE_MEMOS=false
MEMOS_PORT=5230

ENABLE_VIKUNJA=false
VIKUNJA_PORT=3456
# Generate with: openssl rand -hex 32
VIKUNJA_JWT_SECRET=change_this_vikunja_jwt_secret

# ==============================================================================
# 📂 CATEGORY 1: MEDIA
# ==============================================================================
ENABLE_JELLYFIN=true
JELLYFIN_PORT=8096

ENABLE_SONARR=false
SONARR_PORT=8989

ENABLE_RADARR=false
RADARR_PORT=7878

ENABLE_LIDARR=false
LIDARR_PORT=8686

ENABLE_READARR=false
READARR_PORT=8787

ENABLE_PROWLARR=false
PROWLARR_PORT=9696

ENABLE_BAZARR=false
BAZARR_PORT=6767

ENABLE_NAVIDROME=false
NAVIDROME_PORT=4533

ENABLE_AUDIOBOOKSHELF=false
AUDIOBOOKSHELF_PORT=13378

ENABLE_KAVITA=false
KAVITA_PORT=5003

ENABLE_KOMGA=false
KOMGA_PORT=8085

ENABLE_QBITTORRENT=false
QBITTORRENT_PORT=8087

# ==============================================================================
# 📂 CATEGORY 5: MONITORING
# ==============================================================================
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9093

ENABLE_GRAFANA=true
GRAFANA_PORT=3005
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password_in_env

ENABLE_CADVISOR=true
CADVISOR_PORT=8083

ENABLE_NODE_EXPORTER=true
NODE_EXPORTER_PORT=9100
