# ==============================================================================
# Global Homelab Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit '.env' containing real secrets to Git.
# ==============================================================================

# General System Settings
TZ=Asia/Dhaka
PUID=1000
PGID=1000

# Base Storage Paths
# SSD: Fast storage for container configs, application state, and databases
SSD_DATA_DIR=/home/maruf/homelab/volumes

# HDD: Bulk storage for media library, raw backups, and large datasets
HDD_DATA_DIR=/home/maruf/MyHDDStorage

# Specific Media Storage Path (HDD)
JELLYFIN_MEDIA_DIR=/home/maruf/MyHDDStorage/Jellyfin

# ==============================================================================
# 📂 CATEGORY 10: SYSADMIN, DEVOPS & CONTAINER UTILITIES
# ==============================================================================
ENABLE_PORTAINER=true
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443
PORTAINER_TUNNEL_PORT=8000

ENABLE_UPTIME_KUMA=false
UPTIME_KUMA_PORT=3001

# Dashboard & Utilities Stack
DASHBOARD_PORT=7575
IT_TOOLS_PORT=8091

# Finance Stack
MAYBE_PORT=8092
MAYBE_DB_USER=maybe
MAYBE_DB_PASSWORD=change_this_maybe_password
MAYBE_DB_NAME=maybe_production
MAYBE_SECRET_KEY_BASE=change_this_rails_secret_key_base_in_env

# Management Stack
LEANTIME_PORT=8090
LEANTIME_DB_ROOT_PASSWORD=change_this_root_password_in_env
LEANTIME_DB_USER=leantime
LEANTIME_DB_PASSWORD=change_this_user_password_in_env
LEANTIME_DB_NAME=leantime

# Media Stack
JELLYFIN_PORT=8096

# Monitoring Stack
GRAFANA_PORT=3005
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password_in_env
PROMETHEUS_PORT=9093
CADVISOR_PORT=8083
NODE_EXPORTER_PORT=9100
